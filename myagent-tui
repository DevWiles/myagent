#!/usr/bin/env bash
#
# 一行命令把整个软件拉起来：按需装前端依赖，然后起界面。
#
# 后端 jar 的按需 build **不在这里**——在界面里（tui/src/build.ts）。
# 原来在这里同步做，改过一行 Java 之后的每次启动都要对着一行裸文本等 mvn
# 五秒起步；挪进界面之后，界面亚秒级起来，build 进度打在状态栏上，
# 输入框还是活的。脚本只留一件非做不可的事：bun 依赖没装时界面根本起不来，
# 这一步谁也替不了它。
#
# 用法:
#   ./myagent-tui                 在当前目录起界面
#   ./myagent-tui -d ~/proj       指定工作区
#   ./myagent-tui --rebuild       后端强制重 build（由界面执行）
#   ./myagent-tui --help          用法
#
set -euo pipefail

# 从软链接调用也要能找到仓库，所以逐级解开
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")" && pwd)"

TUI="$ROOT/tui"

# 用户敲命令时所在的目录，就是 agent 要干活的工作区。必须在 cd 之前存下来。
#
# 为什么必须 cd：
# Solid 的 JSX 靠 tui/bunfig.toml 里的 preload 插件转换，
# 而 bun 是**按 cwd 找 bunfig.toml** 的。在仓库根目录跑 `bun tui/src/main.tsx`，
# 那份 bunfig 根本不会被加载，JSX 不转换，界面起来就是一片空白然后立刻退出——
# 没有任何报错，非常难查。
# 所以这里换个办法保住工作区语义：先存下 cwd，cd 进界面目录，再用 -d 把它传回去。
WORKSPACE="$PWD"

die() { printf '%s\n' "$*" >&2; exit 1; }

need() {
  command -v "$1" >/dev/null 2>&1 || die "缺少 $1。$2"
}

# --- 参数预处理 -------------------------------------------------------------

# --rebuild 原样传给界面，由 build.ts 执行
ARGS=("$@")

# --help 只是打印文字，跳过依赖安装那一段
for arg in "${ARGS[@]+"${ARGS[@]}"}"; do
  case "$arg" in
    -h|--help)
      need bun "装一个: curl -fsSL https://bun.sh/install | bash"
      cd "$TUI" && exec bun src/main.tsx "${ARGS[@]}"
      ;;
  esac
done

need java "需要 JDK 17 或更高版本。"
need bun  "装一个: curl -fsSL https://bun.sh/install | bash"

# --- 1. 前端依赖 ------------------------------------------------------------

# 用一个安装完成标记来判断新鲜度，而不是直接比 node_modules 目录的时间：
# bun install 自己会重写 bun.lock，于是 lock 永远比 node_modules 新，
# 那样判断的结果是每次启动都重装一遍。标记在安装成功之后才落，就没这个问题。
STAMP="$TUI/node_modules/.myagent-deps-stamp"
if [ ! -f "$STAMP" ] \
   || [ "$TUI/bun.lock" -nt "$STAMP" ] \
   || [ "$TUI/package.json" -nt "$STAMP" ]; then
  echo "› 正在装界面依赖…" >&2
  (cd "$TUI" && bun install --silent) >&2 || die "bun install 失败。"
  touch "$STAMP"
fi

# --- 2. 起界面 --------------------------------------------------------------

# 用户没自己指定工作区的话，把进 cd 之前存下的 cwd 传回去
has_dir=0
for arg in "${ARGS[@]+"${ARGS[@]}"}"; do
  case "$arg" in
    -d|--dir) has_dir=1 ;;
  esac
done
[ "$has_dir" = 0 ] && ARGS+=(-d "$WORKSPACE")

# cd 进界面目录是为了让 bunfig.toml 生效（原因见文件开头那段注释）
cd "$TUI"

# exec 把进程替换掉，这样 Ctrl-C 和退出码都直达界面，中间不隔一层 shell
exec bun src/main.tsx "${ARGS[@]+"${ARGS[@]}"}"
